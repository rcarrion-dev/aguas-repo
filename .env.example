# ---- Base de datos (Server-DB) ----
# Usuario propio de la app, nunca root. Solo SELECT, INSERT, UPDATE, DELETE.
DB_HOST=localhost
DB_PORT=3306
DB_USER=aguas_app
DB_PASSWORD=cambia_esto
DB_NAME=aguas_db

# ---- Tokens de sesión (JWT) ----
# Dos llaves DISTINTAS de mínimo 32 caracteres. Cada quien genera las suyas:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# NUNCA las subas a GitHub ni las pongas en el código. Si se filtran,
# genera otras (todas las sesiones abiertas se cierran, y eso es lo que se quiere).
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- Servidor ----
# Dónde escucha la API. 127.0.0.1 = solo esta máquina.
# En el laboratorio (Server-BE) usar 0.0.0.0 para que la app y el dashboard
# lleguen por la red.
HOST=127.0.0.1
PORT=3000
# production = sin logs de depuración
NODE_ENV=production
# Carpeta de evidencias (opcional; por defecto ./uploads)
# UPLOADS_DIR=

# ---- Opcionales ----
# Orígenes web que pueden llamar a la API desde el navegador (separados por
# coma). La app iOS y el dashboard NO lo necesitan: déjalo vacío.
FRONT_URL=
# true = publica Swagger en /docs. Solo para desarrollo, nunca en la entrega.
ENABLE_DOCS=false

# Configuración del correo para recuperación de contraseña
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=aguasapptec@gmail.com
MAIL_PASSWORD=
MAIL_FROM="Aguas! <aguasapptec@gmail.com>"
